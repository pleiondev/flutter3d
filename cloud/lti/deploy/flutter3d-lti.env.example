# /etc/flutter3d-lti.env — root:root, mode 600. Never in the repository.
#
# One platform's registration (`doc/edu-03-lti-plan.md` §4 — no organisation
# model yet). Get these five from that platform's own "add LTI 1.3 external
# tool" screen after pointing it at this service's /login and /.well-known
# endpoints — `cloud/lti/moodle-sandbox-setup.md` walks through it for a
# Moodle, field for field.

LTI_BASE_URL=https://lti.pleion.dev
LTI_PLATFORM_ISSUER=
LTI_PLATFORM_CLIENT_ID=
LTI_PLATFORM_DEPLOYMENT_ID=
LTI_PLATFORM_AUTH_LOGIN_URL=
LTI_PLATFORM_JWKS_URL=

# Optional — needed only for lti-04's AGS half (score passback to the
# platform's own gradebook). Get the auth token URL from the same "add LTI
# 1.3 external tool" screen as the five above.
#LTI_PLATFORM_AUTH_TOKEN_URL=

# Optional — this tool's own signing identity for lti-04's AGS half. Run
# `dart run tool/generate_tool_key.dart /etc/flutter3d-lti/tool-key.json`
# once, register the JWKS entry it prints at the platform, then point this
# at the file.
#LTI_TOOL_KEY_FILE=/etc/flutter3d-lti/tool-key.json

# Optional — lti-04's xAPI half. Both or neither: a statementsEndpoint with
# no auth header (or the reverse) is treated as unset.
#LTI_LRS_STATEMENTS_ENDPOINT=https://lrs.example.test/xapi/statements
#LTI_LRS_AUTHORIZATION=Basic base64(key:secret)
