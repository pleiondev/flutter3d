# /etc/systemd/system/cloudflared-lessons.service
[Unit]
Description=Cloudflare Tunnel (lessons.pleion.dev -> :8795)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/cloudflared --no-autoupdate --config /etc/cloudflared/lessons.yml tunnel run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
