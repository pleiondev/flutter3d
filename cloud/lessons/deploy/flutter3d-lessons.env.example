# /etc/flutter3d-lessons.env — root:root, mode 600. Never in the repository.
#
# Shorter than flutter3d-models.env.example on purpose: no database, no mail
# key, no signing secret, because this service has no account to protect.

# What the service calls itself in the embed snippet a lesson page shows.
LESSONS_BASE_URL=https://lessons.pleion.dev
