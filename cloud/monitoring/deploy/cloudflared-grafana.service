# /etc/systemd/system/cloudflared-grafana.service
[Unit]
Description=Cloudflare Tunnel (grafana.pleion.dev -> :8797)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/cloudflared --no-autoupdate --config /etc/cloudflared/grafana.yml tunnel run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
