{
  "title": "flutter3d models",
  "uid": "flutter3d-models",
  "editable": false,
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-7d", "to": "now" },
  "refresh": "1m",
  "tags": ["flutter3d", "models"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Registered users",
      "description": "Accounts that exist right now, verified or not.",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "flutter3d_models_registered_users",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0 },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "none",
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Verified users",
      "description": "Accounts with a confirmed email address.",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "flutter3d_models_verified_users",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0 },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "none",
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Models uploaded",
      "description": "Models on the service right now, across every account.",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "flutter3d_models_uploaded_models",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0 },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "none",
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Storage used",
      "description": "Bytes held by uploaded files, deduplicated by content hash — what is actually on disk.",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "flutter3d_models_storage_bytes",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes", "decimals": 1 },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "none",
        "colorMode": "value"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Registered vs. verified users",
      "gridPos": { "x": 0, "y": 4, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "flutter3d_models_registered_users",
          "legendFormat": "registered",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        },
        {
          "expr": "flutter3d_models_verified_users",
          "legendFormat": "verified",
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0, "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Models uploaded",
      "gridPos": { "x": 8, "y": 4, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "flutter3d_models_uploaded_models",
          "legendFormat": "models",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0, "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Storage used",
      "gridPos": { "x": 16, "y": 4, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "flutter3d_models_storage_bytes",
          "legendFormat": "bytes",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes", "decimals": 1, "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    }
  ]
}
