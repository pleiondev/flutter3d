# /etc/flutter3d-models.env — root:root, mode 600. Never in the repository.

# What the service calls itself in the links it writes into letters.
MODELS_BASE_URL=https://models.pleion.dev

# The models-postgres container, on its loopback port.
MODELS_DATABASE_URL=postgres://models:CHANGE_ME@127.0.0.1:5434/models

# The sender Resend was told about. The domain's SPF and DKIM records are in
# Cloudflare DNS, as Resend lists them when the domain is added.
MODELS_MAIL_FROM=flutter3d models <models@pleion.dev>

# Without a key, letters go to the journal instead of being sent.
MODELS_RESEND_API_KEY=

# `openssl rand -base64 48`
MODELS_SECRET=
