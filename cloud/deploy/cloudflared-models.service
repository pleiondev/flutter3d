# /etc/systemd/system/cloudflared-models.service
[Unit]
Description=Cloudflare Tunnel (models.pleion.dev -> :8793)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/cloudflared --no-autoupdate --config /etc/cloudflared/models.yml tunnel run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
