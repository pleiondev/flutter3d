  "toolSculptDrawLabel": "Draw",
  "toolSculptDrawAbout": "Pushes everything under the brush out along one shared direction, the way a stamp would.",
  "toolSculptClayLabel": "Clay",
  "toolSculptClayAbout": "Builds the surface up in flat layers, like thumbing clay on.",
  "toolSculptInflateLabel": "Inflate",
  "toolSculptInflateAbout": "Pushes each vertex along its own normal, so a rounded patch puffs up rather than rising as a plane.",
  "toolSculptSmoothLabel": "Smooth",
  "toolSculptSmoothAbout": "Evens out what is under the brush, taking the bumps down.",
  "toolSculptFlattenLabel": "Flatten",
  "toolSculptFlattenAbout": "Pulls everything under the brush toward one plane.",
  "toolSculptGrabLabel": "Grab",
  "toolSculptGrabAbout": "Drags the vertices under the brush along with the pointer.",
  "toolSculptPinchLabel": "Pinch",
  "toolSculptPinchAbout": "Pulls the vertices under the brush toward its centre.",
  "toolSculptCreaseLabel": "Crease",
  "toolSculptCreaseAbout": "Pinches and sinks at once, which is how a fold is cut in.",
  "toolRetopoQuadLabel": "Draw a quad",
  "toolRetopoQuadAbout": "Click four points on the high mesh; each one snaps to a vertex the new mesh already has, or lands on the surface.",
  "toolRetopoAutoLabel": "Retopologize",
  "toolRetopoAutoAbout": "Rebuilds the whole surface as quads at about the count the panel asks for, shrink-wrapped back onto the original.",
  "toolRetopoBakeLabel": "Bake the maps",
  "toolRetopoBakeAbout": "Bakes the high mesh's own surface into the low one's UVs — a normal map, an occlusion map, or both.",
  "toolPaintBrushLabel": "Brush",
  "toolPaintBrushAbout": "Paints onto the object's own texture, through its UVs — a stroke over a seam paints both islands.",
  "toolPaintFillLabel": "Fill the layer",
  "toolPaintFillAbout": "Floods the whole layer with the colour on the palette.",
  "toolPaintClearLabel": "Clear the layer",
  "toolPaintClearAbout": "Empties the layer without touching the ones under it.",
  "toolSimSelectLabel": "Select",
  "toolSimSelectAbout": "Pick the vertices a cloth hangs from, or the object to solve.",
  "toolSimPinLabel": "Pin the selection",
  "toolSimPinAbout": "Holds the selected vertices still while everything else falls.",
  "toolSimBakeLabel": "Bake",
  "toolSimBakeAbout": "Solves the whole clip and keeps it, so it can be scrubbed.",
  "toolRenderSnapshotLabel": "Render",
  "toolRenderSnapshotAbout": "Renders the project at the size on the panel, one tile at a time, and shows the result.",
  "toolRenderSaveLabel": "Save the picture",
  "toolRenderSaveAbout": "Writes the last render out as a PNG.",
