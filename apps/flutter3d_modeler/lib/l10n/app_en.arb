  "toolObjectSelectLabel": "Select",
  "toolObjectSelectAbout": "Click an object to work on it; shift-click adds to what is already picked.",
  "toolObjectMoveLabel": "Move",
  "toolObjectMoveAbout": "Drag an arrow to slide it along one axis, or the centre to move it freely.",
  "toolObjectRotateLabel": "Rotate",
  "toolObjectRotateAbout": "Drag a ring to turn it about that axis.",
  "toolObjectScaleLabel": "Scale",
  "toolObjectScaleAbout": "Drag a handle to grow or shrink it — one axis at a time, or all three from the centre.",
  "toolObjectAddLabel": "Add a box",
  "toolObjectAddAbout": "Puts a new box at the origin, still parametric: its size and segment counts stay editable in the panel.",
  "toolObjectDuplicateLabel": "Duplicate",
  "toolObjectDuplicateAbout": "Copies what is selected and selects the copy, leaving the original where it was.",
  "toolObjectBakeLabel": "Convert to a mesh",
  "toolObjectBakeAbout": "Turns a shape that still knows its own parameters into plain editable geometry. Its size and segment fields go away.",
  "toolObjectLatheLabel": "Add a lathe",
  "toolObjectLatheAbout": "Spins a profile you draw around an axis — how a vase, a bottle or a wheel is made.",
  "toolObjectOriginLabel": "Origin to the bottom",
  "toolObjectOriginAbout": "Moves the point the object turns and scales about down to its lowest vertex, so it sits on the floor.",
  "toolObjectApplyLabel": "Apply the transform",
  "toolObjectApplyAbout": "Folds the position, rotation and scale into the vertices themselves and leaves the transform at rest.",
  "toolObjectDeleteLabel": "Delete",
  "toolObjectDeleteAbout": "Removes what is selected. Undo brings it back.",
  "toolMeshSelectLabel": "Select",
  "toolMeshSelectAbout": "Click a vertex, edge or face; shift-click adds to what is already picked.",
  "toolMeshLassoLabel": "Lasso select",
  "toolMeshLassoAbout": "Draw a freehand loop round what you want instead of clicking each part of it.",
  "toolMeshLinkedLabel": "Select linked",
  "toolMeshLinkedAbout": "Takes everything joined to what is already picked — one whole shell of a mesh that has several.",
  "toolMeshMoveLabel": "Move",
  "toolMeshMoveAbout": "Drags the picked elements. Typing a number while dragging sets the distance exactly.",
  "toolMeshRotateLabel": "Rotate",
  "toolMeshRotateAbout": "Turns the picked elements about the middle of the selection.",
  "toolMeshScaleLabel": "Scale",
  "toolMeshScaleAbout": "Grows or shrinks the picked elements about the middle of the selection.",
  "toolMeshExtrudeLabel": "Extrude",
  "toolMeshExtrudeAbout": "Pulls new geometry out of the picked faces and leaves a wall joining it to where it came from.",
  "toolMeshLoopCutLabel": "Loop cut",
  "toolMeshLoopCutAbout": "Adds a ring of edges all the way round the mesh, where the next change of shape needs one to bend at.",
  "toolMeshBevelLabel": "Bevel",
  "toolMeshBevelAbout": "Replaces a sharp edge with a narrow strip, so light catches it the way it does on a real object.",
  "toolMeshInsetLabel": "Inset",
  "toolMeshInsetAbout": "Shrinks a face inward and walls the ring it leaves — how a panel, a window or a recessed button is made.",
  "toolMeshBridgeLabel": "Bridge",
  "toolMeshBridgeAbout": "Joins two open borders with a ring of quads, so two halves of a tube become one surface.",
  "toolMeshSlideLabel": "Edge slide",
  "toolMeshSlideAbout": "Moves a loop along the edges that cross it, changing where a seam sits without changing a single face.",
  "toolMeshTriangulateLabel": "Triangulate",
  "toolMeshTriangulateAbout": "Cuts every face into triangles — what a game engine reads, and what a face with more than four corners has to become first.",
  "toolMeshSeparateLabel": "Separate",
  "toolMeshSeparateAbout": "Moves the picked faces out into an object of their own.",
  "toolMeshDissolveLabel": "Dissolve edges",
  "toolMeshDissolveAbout": "Removes the picked edges but keeps the surface, merging the faces they divided into one.",
  "toolMeshFillHolesLabel": "Fill holes",
  "toolMeshFillHolesAbout": "Closes every open boundary — the gaps that make a model look see-through from one side.",
  "toolMeshMergeLabel": "Merge by distance",
  "toolMeshMergeAbout": "Fuses vertices sitting on top of each other, which is what a scan or an STL arrives full of.",
  "toolMeshNormalsLabel": "Recalculate normals",
  "toolMeshNormalsAbout": "Points every face outward again, so the surface stops reading as inside-out.",
  "toolMeshFlipLabel": "Flip normals",
  "toolMeshFlipAbout": "Turns the picked faces the other way round, for the shell that really is meant to be seen from inside.",
  "toolMeshDeleteLabel": "Delete",
  "toolMeshDeleteAbout": "Removes the picked vertices, edges or faces, and whatever depended on them.",
  "toolPoseSelectLabel": "Select",
  "toolPoseSelectAbout": "Click a joint of the skeleton to pose it.",
  "toolPoseKeyLabel": "Key the pose",
  "toolPoseKeyAbout": "Writes the pose on screen into the clip, at the frame the playhead is on.",
  "toolPoseDeleteKeyLabel": "Delete the key",
  "toolPoseDeleteKeyAbout": "Takes this frame's key back out, leaving the keys either side to carry the motion through it.",
  "toolPoseAutoRigLabel": "Auto-rig…",
  "toolPoseAutoRigAbout": "Builds a skeleton from a handful of points you place on the model.",
  "toolWeightsPaintLabel": "Paint weights",
  "toolWeightsPaintAbout": "Brushes how strongly the chosen joint pulls on the surface under the cursor.",
  "toolWeightsAssignLabel": "Assign to the joint",
  "toolWeightsAssignAbout": "Gives every vertex the brush touches to the chosen joint, at full strength.",
  "toolWeightsMirrorLabel": "Mirror",
  "toolWeightsMirrorAbout": "Copies one side's weights onto the other, so a symmetrical model is painted once.",
  "toolWeightsNormalizeLabel": "Normalize",
  "toolWeightsNormalizeAbout": "Makes each vertex's pulls add up to one and drops the smallest past the profile's own limit.",
  "toolRetargetImportLabel": "Import a source clip",
  "toolRetargetImportAbout": "Reads a clip out of another file to drive this rig with.",
  "toolRetargetAutoMapLabel": "Map bones automatically",
  "toolRetargetAutoMapAbout": "Guesses which bone of the source matches which of this rig, from their names.",
  "toolRetargetApplyLabel": "Apply the retarget",
  "toolRetargetApplyAbout": "Writes the mapped motion onto this rig as a clip of its own.",
  "toolMorphsAddLabel": "Add a shape",
  "toolMorphsAddAbout": "Takes the mesh as it stands now as a shape the slider can blend towards.",
  "toolMorphsKeyLabel": "Key the shape",
  "toolMorphsKeyAbout": "Writes the shape weights as they stand into the clip, at the playhead.",
  "toolMorphsDeleteLabel": "Delete the shape",
  "toolMorphsDeleteAbout": "Removes the selected shape and the slider that drove it.",
