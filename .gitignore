/android/app/release

# Generated by each package's tool/build_shaders.sh. Not committed: the bundle
# format is tied to the Flutter version, so a checked-in one would be stale for
# anybody on a different SDK and would hide the need to rebuild.
#
# Matched by extension anywhere in the tree rather than under one package's
# path. Every flutter3d_* extension ships its own bundle, and a rule that named
# `packages/flutter3d/` would have let the next package's bundle — half a
# megabyte of generated, SDK-specific binary — be committed by accident, with
# nothing to notice it but a reviewer reading a diff of Metal source.
*.shaderbundle

# Flutter build output in any package, not just the root.
build/

# Machine-local, and asked to stay out of git.
HANDOFF.md
.claude/
