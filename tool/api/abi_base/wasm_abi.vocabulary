# Recorded from the working tree (no release tagged yet) by `dart run api_snapshot:abi_base`.
# A language's vocabulary, one fact a line, each ending in the version
# it arrived in; "<language> version <N>" is the newest this build
# reads. Generated; a line new since the base recorded at the tag
# carries a version above the base's newest (the rule `a language's
# vocabulary grows only with its version`).
wasm export f3d_abi 1
wasm export f3d_step 1
wasm import f3d field_frac 2
wasm import f3d field_get 1
wasm import f3d field_len 1
wasm import f3d field_set 1
wasm import f3d publish 1
wasm minimum 1
wasm version 2
