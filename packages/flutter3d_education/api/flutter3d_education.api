  const XapiActor({required this.name, required this.homePage, required this.accountName})
  factory XapiActor.fromLtiSubject({required String name, required String platformIssuer, required String subject})
  final String accountName
  final String homePage
  final String name

final class XapiClient
  Future<void> send(XapiStatement statement)
  XapiClient({required this.lrs, http.Client? httpClient})
  final XapiLrsSettings lrs
  void close()

final class XapiException extends ResourceException
  String toString()
  const XapiException(this.message)
  final String message

final class XapiLrsSettings
  XapiLrsSettings copyWith({Uri? statementsEndpoint, String? authorizationHeader})
  const XapiLrsSettings({required this.statementsEndpoint, required this.authorizationHeader})
  final String authorizationHeader
  final Uri statementsEndpoint

final class XapiResult
  Map<String, dynamic> toJson()
  const XapiResult({this.success, this.response, this.scoreScaled})
  final String? response
  final bool? success
  final double? scoreScaled

final class XapiStatement
  Map<String, dynamic> toJson()
  XapiStatement({String? id, required this.actor, required this.verb, required this.object, this.result, DateTime? timestamp})
  final DateTime timestamp
  final String id
  final XapiActivity object
  final XapiActor actor
  final XapiResult? result
  final XapiVerb verb

final class XapiVerb
  Map<String, dynamic> toJson()
  const XapiVerb({required this.id, required this.display})
  final String display
  final String id
  static const answered = XapiVerb(id: 'http://adlnet.gov/expapi/verbs/answered', display: 'answered')
  static const completed = XapiVerb(id: 'http://adlnet.gov/expapi/verbs/completed', display: 'completed')

({pc.RSAPublicKey publicKey, pc.RSAPrivateKey privateKey}) generateRsaKeyPair()

String generateUuidV4()

pc.RSAPrivateKey rsaPrivateKeyFromJwk(Map<String, dynamic> jwk)

Map<String, Object?> rsaPrivateKeyToJwk(pc.RSAPrivateKey key, {required String kid})

djwt.RSAPublicKey rsaPublicKeyFromJwk(Map<String, dynamic> jwk)

Map<String, Object?> rsaPublicKeyToJwk(pc.RSAPublicKey key, {required String kid})
