// The floor under a sea, lit through its surface: the caustics the
// surface's ripples focus on it, and the colour the water takes out of the
// light on its way down and on its way back up to the eye.
//
// The ripples are the liquid material's own six, as `liquid.f3dmat` writes
// them at full strength, so what the floor shows is the surface above it. Caustics by
// geometric optics: light reaching the floor at depth d came through the
// surface at x, bent by the surface's slope, and lands at
// y = x + a·∇η(x), a = d·(1 − 1/n), n = 1.33; a patch of surface dA lands on
// |det(I + a·H)|·dA of floor, H the surface's Hessian, so the floor is lit
// 1/|det(I + a·H)| times as brightly — bright lines where the patches fold.
// Water takes light out channel by channel as Beer and Lambert say, red
// first: over the sun's path down and the eye's path through it, and gives
// back its own scattered blue-green in their place.
material Seabed {
  uniform float time = 0.0;
  uniform float chop = 1.0;
  // Where the eye is, and the sea's surface height.
  uniform vec3 eye = vec3(0.0, 10.0, 0.0);
  uniform float level = 0.0;
  // Towards the sun, a unit vector, and the light it brings.
  uniform vec3 toSun = vec3(-0.35, 0.7, 0.6);
  uniform vec3 sunColor = vec3(2.0, 1.95, 1.85);
  // What a metre of the water takes out of red, green and blue — clear
  // tropical water's, mostly by the water itself — and the colour of the
  // light it scatters back.
  uniform vec3 absorb = vec3(0.45, 0.065, 0.025);
  uniform vec3 scatter = vec3(0.05, 0.22, 0.30);

  fragment {
    let here = world.xz;
    let depth = max(level - world.y, 0.0);
    let bend = depth * 0.248;

    // Where the light reaching here crossed the surface: back along the
    // sun's refracted ray, then back by the slope's turn of it, once.
    let sunDown = vec2(toSun.x, toSun.z) * (0.75 / max(toSun.y, 0.2));
    let start = here + sunDown * depth;
    // The sun is half a degree wide, 0.007 radians in the water: each point
    // of floor sees it blurred over 0.007·d, and a ripple of wavenumber k
    // focuses its light that much less, by exp(−(k·w)²/2).
    let blurWidth = 0.007 * depth;
    let d1 = vec2(0.966, 0.259);
    let s1 = 0.07 * chop * pow(0.60653, (3.7 * blurWidth) * (3.7 * blurWidth));
    let d2 = vec2(0.174, 0.985);
    let s2 = 0.07 * chop * pow(0.60653, (5.56 * blurWidth) * (5.56 * blurWidth));
    let d3 = vec2(-0.766, 0.643);
    let s3 = 0.065 * chop * pow(0.60653, (8.16 * blurWidth) * (8.16 * blurWidth));
    let d4 = vec2(-0.906, -0.423);
    let s4 = 0.06 * chop * pow(0.60653, (12.08 * blurWidth) * (12.08 * blurWidth));
    let d5 = vec2(-0.174, -0.985);
    let s5 = 0.055 * chop * pow(0.60653, (16.98 * blurWidth) * (16.98 * blurWidth));
    let d6 = vec2(0.819, -0.574);
    let s6 = 0.05 * chop * pow(0.60653, (24.17 * blurWidth) * (24.17 * blurWidth));
    // Where the light reaching here crossed the surface: back along the
    // sun's refracted ray, then back by the slope's turn of it, three times
    // over to settle; the surface bent slowly as `liquid.f3dmat` bends it.
    let b0 = start + vec2(0.3 * sin(0.73 * start.y + 0.4 * time),
                           0.3 * sin(0.61 * start.x - 0.3 * time));
    let g0 = d1 * (s1 * cos(3.7 * dot(d1, b0) - 6.02 * time)) +
               d2 * (s2 * cos(5.56 * dot(d2, b0) - 7.39 * time)) +
               d3 * (s3 * cos(8.16 * dot(d3, b0) - 8.95 * time)) +
               d4 * (s4 * cos(12.08 * dot(d4, b0) - 10.89 * time)) +
               d5 * (s5 * cos(16.98 * dot(d5, b0) - 12.91 * time)) +
               d6 * (s6 * cos(24.17 * dot(d6, b0) - 15.4 * time));
    let x1 = start - g0 * bend;
    let b1 = x1 + vec2(0.3 * sin(0.73 * x1.y + 0.4 * time),
                           0.3 * sin(0.61 * x1.x - 0.3 * time));
    let g1 = d1 * (s1 * cos(3.7 * dot(d1, b1) - 6.02 * time)) +
               d2 * (s2 * cos(5.56 * dot(d2, b1) - 7.39 * time)) +
               d3 * (s3 * cos(8.16 * dot(d3, b1) - 8.95 * time)) +
               d4 * (s4 * cos(12.08 * dot(d4, b1) - 10.89 * time)) +
               d5 * (s5 * cos(16.98 * dot(d5, b1) - 12.91 * time)) +
               d6 * (s6 * cos(24.17 * dot(d6, b1) - 15.4 * time));
    let x2 = start - g1 * bend;
    let b2 = x2 + vec2(0.3 * sin(0.73 * x2.y + 0.4 * time),
                           0.3 * sin(0.61 * x2.x - 0.3 * time));
    let g2 = d1 * (s1 * cos(3.7 * dot(d1, b2) - 6.02 * time)) +
               d2 * (s2 * cos(5.56 * dot(d2, b2) - 7.39 * time)) +
               d3 * (s3 * cos(8.16 * dot(d3, b2) - 8.95 * time)) +
               d4 * (s4 * cos(12.08 * dot(d4, b2) - 10.89 * time)) +
               d5 * (s5 * cos(16.98 * dot(d5, b2) - 12.91 * time)) +
               d6 * (s6 * cos(24.17 * dot(d6, b2) - 15.4 * time));
    let at = start - g2 * bend;
    let bat = at + vec2(0.3 * sin(0.73 * at.y + 0.4 * time),
                        0.3 * sin(0.61 * at.x - 0.3 * time));
    // The Hessian there: each wave −A·k²·sin(phase)·d dᵀ, A·k its slope.
    let c1 = 0.0 - s1 * 3.7 * sin(3.7 * dot(d1, bat) - 6.02 * time);
    let c2 = 0.0 - s2 * 5.56 * sin(5.56 * dot(d2, bat) - 7.39 * time);
    let c3 = 0.0 - s3 * 8.16 * sin(8.16 * dot(d3, bat) - 8.95 * time);
    let c4 = 0.0 - s4 * 12.08 * sin(12.08 * dot(d4, bat) - 10.89 * time);
    let c5 = 0.0 - s5 * 16.98 * sin(16.98 * dot(d5, bat) - 12.91 * time);
    let c6 = 0.0 - s6 * 24.17 * sin(24.17 * dot(d6, bat) - 15.4 * time);
    let hxx = c1 * d1.x * d1.x +
              c2 * d2.x * d2.x +
              c3 * d3.x * d3.x +
              c4 * d4.x * d4.x +
              c5 * d5.x * d5.x +
              c6 * d6.x * d6.x;
    let hzz = c1 * d1.y * d1.y +
              c2 * d2.y * d2.y +
              c3 * d3.y * d3.y +
              c4 * d4.y * d4.y +
              c5 * d5.y * d5.y +
              c6 * d6.y * d6.y;
    let hxz = c1 * d1.x * d1.y +
              c2 * d2.x * d2.y +
              c3 * d3.x * d3.y +
              c4 * d4.x * d4.y +
              c5 * d5.x * d5.y +
              c6 * d6.x * d6.y;
    let det = (1.0 + bend * hxx) * (1.0 + bend * hzz) - bend * bend * hxz * hxz;
    // Folded patches meet at a line of infinite brightness; the sun's own
    // width, half a degree, spreads it to a few times the mean.
    let focus = min(1.0 / max(abs(det), 0.12), 6.0);

    // Down through the water to here, and from here back to the eye: the
    // eye's path is all of it when the eye is under the surface, and only
    // the part below the surface when it is above.
    let throughDown = pow(vec3(0.3679), absorb * (depth / max(toSun.y, 0.2)));
    let toEye = length(eye - world);
    let eyeDepth = max(level - eye.y, 0.0);
    let path = mix(depth * toEye / max(depth + max(eye.y - level, 0.0), 0.001),
                   toEye, step(0.0, eyeDepth - 0.001));
    let throughUp = pow(vec3(0.3679), absorb * path);

    let facing = clamp(dot(normal, vec3(toSun.x * 0.75, max(toSun.y, 0.2), toSun.z * 0.75)), 0.0, 1.0);
    let floorLit = albedo * (sunColor * (facing * focus) * throughDown + ambient * throughDown);
    let back = scatter * (sunColor * throughDown + ambient);
    return vec4(floorLit * throughUp + back * (vec3(1.0) - throughUp), 1.0);
  }
}
