  final Vector3 gravity
  final Vector3 wind
  final double drag
  final double floorY
  final double friction
  final double restitution

typedef PhysicsStart = ({PhysicsBackend backend, String? fallbackBecause});

final class RagdollBall extends RagdollJoint
  const RagdollBall({required this.cone, required this.twistLower, required this.twistUpper})
  final double cone
  final double twistLower
  final double twistUpper

final class RagdollBend extends RagdollJoint
  const RagdollBend({this.most = 2.4, this.least = 0.05, required this.otherwise})
  final RagdollJoint otherwise
  final double least
  final double most

final class RagdollBone
  const RagdollBone({required this.name, required this.parent, required this.head, required this.tail, required this.orientation, required this.radius, required this.mass, this.joint})
  final Quaternion orientation
  final RagdollJoint? joint
  final String name
  final Vector3 head
  final Vector3 tail
  final double mass
  final double radius
  final int parent

final class RagdollHinge extends RagdollJoint
  const RagdollHinge({required this.axis, required this.lower, required this.upper})
  final Vector3 axis
  final double lower
  final double upper

sealed class RagdollJoint
  const RagdollJoint()

