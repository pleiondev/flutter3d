# The MCP tools of flutter3d_sim_mcp: what each server offers an agent.
# Generated by `dart run api_snapshot:schema_snapshot --update flutter3d_sim_mcp` in tool/api. Do not edit.
# A change here is a semver decision: see "Tools for agents are a contract too" in CONTRIBUTING.md.

server flutter3d.diagnostics
  schema 1.0.0
  alias frame -> render.frame
  alias open -> level.open
  alias passes -> render.passes
  alias pixel -> render.pixel
  alias scanNaN -> render.scanNan

tool flutter3d.schema
  says The schema versions this server speaks: its own, and each plugin namespace's that declared one.
  hints readOnly idempotent
  out {"properties":{"namespaces":{"additionalProperties":{"type":"string"},"type":"object"},"schemaVersion":{"type":"string"},"server":{"type":"string"}},"required":["namespaces","server"],"type":"object"}

tool level.open
  says Open a level document for diagnosis.
  hints writes
  arg path required {"type":"string"}

tool render.frame
  says Draw a frame with no GPU, from a given eye position looking in a given direction, in one of the renderer's own debug views.
  hints readOnly
  arg aimX {"type":"number"}
  arg aimY {"type":"number"}
  arg aimZ {"type":"number"}
  arg atX {"type":"number"}
  arg atY {"type":"number"}
  arg atZ {"type":"number"}
  arg view {"type":"string"}

tool render.passes
  says Every pass the frame graph kept for the last frame drawn, in the order it ran, with its own timing — what actually happened, rather than what the settings asked for.
  hints readOnly

tool render.pixel
  says The raw, unclamped value of one pixel in the last frame drawn — a depth past one metre and a NaN both survive here, where the picture itself would have rounded either into an ordinary-looking colour.
  hints readOnly
  arg x required {"type":"integer"}
  arg y required {"type":"integer"}

tool render.scanNan
  says The first pixel in the last frame drawn where any channel is a NaN or an infinity, and which pass is answerable for it.
  hints readOnly

server flutter3d.sim
  schema 1.0.0
  alias bisect -> run.bisect
  alias digest -> run.digest
  alias expect -> run.expect
  alias frame -> view.frame
  alias open -> level.open
  alias order -> game.order
  alias snapshot -> state.snapshot
  alias step -> run.step
  alias verify -> run.verify
  alias writeRun -> run.write

tool flutter3d.schema
  says The schema versions this server speaks: its own, and each plugin namespace's that declared one.
  hints readOnly idempotent
  out {"properties":{"namespaces":{"additionalProperties":{"type":"string"},"type":"object"},"schemaVersion":{"type":"string"},"server":{"type":"string"}},"required":["namespaces","server"],"type":"object"}

tool game.order
  says Give the {game} an order, then step it forward with the stick at rest.
  when game is OrderedGame
  hints writes
  arg steps {"type":"integer"}
  arg verb required {"enum":["{order}"],"type":"string"}
  arg {argument} {"type":"number"}

tool level.open
  says Open a {game} level (a .json level document) and stand the player up at its spawn.
  hints writes
  arg path required {"type":"string"}

tool run.bisect
  says Play two .f3drun files of the same level side by side, each in a fresh world of its own, and say the first step at which they differ and the first field that does, as a path into the state (players.0.health).
  hints readOnly
  arg a required {"type":"string"}
  arg b required {"type":"string"}
  arg entities {"properties":{"ecs":{"items":{"type":"string"},"type":"array"},"rows":{"type":"string"}},"type":"object"}

tool run.digest
  says The most recent checkpoint digest and the step it was taken at — one every 25 steps.
  hints readOnly

tool run.expect
  says Back a claim with a replay: step forward holding one intent (the same arguments as step) until the predicate holds or `limit` steps pass, then write the whole run so far to `path` as a .f3drun.
  hints writes
  arg limit required {"type":"integer"}
  arg lookX {"type":"number"}
  arg lookY {"type":"number"}
  arg moveX {"type":"number"}
  arg moveY {"type":"number"}
  arg path required {"type":"string"}
  arg predicate required {"properties":{"atLeast":{"type":"number"},"below":{"type":"number"},"is":{"type":"boolean"},"kind":{"enum":["near","inside","alive","health"],"type":"string"},"max":{"items":{"type":"number"},"type":"array"},"min":{"items":{"type":"number"},"type":"array"},"point":{"items":{"type":"number"},"type":"array"},"who":{"type":"string"},"within":{"type":"number"}},"required":["kind"],"type":"object"}
  arg {button} {"type":"boolean"}

tool run.step
  says Run the level forward, holding one intent for every step.
  hints writes
  arg lookX {"type":"number"}
  arg lookY {"type":"number"}
  arg moveX {"type":"number"}
  arg moveY {"type":"number"}
  arg steps required {"type":"integer"}
  arg {button} {"type":"boolean"}

tool run.verify
  says Replay a .f3drun into a fresh run of its own level, apart from the run this session has open, and say whether it retraces the digest checkpoints it was written with — or the first checkpoint where it does not.
  hints readOnly
  arg path required {"type":"string"}
  arg predicate {"properties":{"atLeast":{"type":"number"},"below":{"type":"number"},"is":{"type":"boolean"},"kind":{"enum":["near","inside","alive","health"],"type":"string"},"max":{"items":{"type":"number"},"type":"array"},"min":{"items":{"type":"number"},"type":"array"},"point":{"items":{"type":"number"},"type":"array"},"who":{"type":"string"},"within":{"type":"number"}},"required":["kind"],"type":"object"}

tool run.write
  says Write everything stepped so far as a .f3drun — the level, its hash, the starting snapshot, every step's input, and the digest trace.
  hints writes
  arg path required {"type":"string"}

tool state.snapshot
  says Where things stand right now, as JSON: the step, and what the game reads out — for the player, position, facing and health; for every actor the level spawned, position, health, and whether it is still up.
  hints readOnly

tool view.frame
  says A picture of the room, from the player's own eye, rendered with no GPU.
  hints readOnly
