final class CpuStage
  const CpuStage.compute(this.compute)
  const CpuStage.fragment(this.fragment)
  const CpuStage.vertex(this.vertex)
  final CpuComputeShader? compute
  final CpuFragmentShader? fragment
  final CpuVertexShader? vertex

abstract base mixin class CpuStorageReader
  abstract Set<String> get storageBindings

final class CpuStorageTexture
  CpuStorageTexture(this.planes, this.format, this.access)
  Vector4 load(int x, int y, [int z = 0])
  factory CpuStorageTexture.bind(TextureHandle texture, {required int mipLevel, required StorageTextureAccess access, required DeviceFeatures features, required TextureFormatSupport support, required String backend})
  final List<CpuTexture> planes
  final StorageTextureAccess access
  final TextureFormat format
  int get depth
  int get height
  int get width
  void store(int x, int y, Vector4 value, [int z = 0])

final class CpuTexture
  CpuTexture plane({int mipLevel = 0, int z = 0})
  CpuTexture subresource({int face = 0, int mipLevel = 0, int layer = 0})
  CpuTexture(this.width, this.height, this.format)
  Float32List depthBuffer()
  Float32List? depth
  List<CpuTexture>? faces
  List<CpuTexture>? layers
  List<CpuTexture>? levels
  List<CpuTexture>? slices
  Uint8List stencilBuffer()
  Uint8List? stencil
  final Float32List pixels
  final TextureFormat format
  final int height
  final int width
  int planeCount([int mipLevel = 0])

abstract base class CpuVertexShader
  abstract Vector4 run(Float32List attributes, ShaderBindings bindings, Float32List varyings)
  abstract int get varyingCount
  const CpuVertexShader()

abstract base class CpuVertexShaderByIndex extends CpuVertexShader
  abstract Vector4 runAt(int vertexIndex, int instanceIndex, Float32List attributes, ShaderBindings bindings, Float32List varyings)
  const CpuVertexShaderByIndex()

final class FragmentContext
  Float32List? ddx
  Float32List? ddy
  FragmentContext()
  Vector3? debugSurface
  Vector4? albedo
  Vector4? source1
  Vector4? surface
  bool frontFacing
  double? fragDepth
  final Vector4 coord

final class FrameDifference
  String toString()
  const FrameDifference({required this.differing, required this.pixels, required this.worstChannel})
  double get percent
  final int differing
  final int pixels
  final int worstChannel

final class PngStripWriter
  PngStripWriter({required this.width, required this.height, required this.sink})
  final int height
  final int width
  final void Function(Uint8List bytes) sink
  void addRows(Uint8List rgba, int rows)
  void close()

final class ShaderBindings
  Float32List? read(String block, String member)
  Matrix4 mat4(String block, String member, {int at = 0})
  ShaderBindings.forDraw(this.blocks, this.textures, {this.storage = const <String, ByteData>{}, this.storageTextures = const <String, CpuStorageTexture>{}})
  Vector4 vec4(String block, String member, Vector4 fallback, {int at = 0})
  const ShaderBindings(this.blocks, this.textures, {this.storage = const <String, ByteData>{}, this.storageTextures = const <String, CpuStorageTexture>{}})
  final Map<String, BoundTexture> textures
  final Map<String, ByteData> storage
  final Map<String, CpuStorageTexture> storageTextures
  final Map<String, Map<String, Float32List>> blocks

Map<String, CpuStage> builtinCpuShaders()

FrameDifference compareFrames(Uint8List a, Uint8List b, {int channel = 8, bool alpha = false})

int differingPixels(Uint8List a, Uint8List b, {int channel = 8, bool alpha = false})

Uint8List encodePng(Uint8List rgba, int width, int height)

Registration registerCpuBackend(DeviceRegistry registry, {CpuMaterialCompiler? materialCompiler})

library package:flutter3d_cpu/testing.dart

({CpuDevice device, TextureHandle albedo, TextureHandle normal}) cpuTestDevice({int width = 96, int height = 72})

const CpuStage cpuUnlitStage = CpuStage.fragment(UnlitShader())

TextureHandle texelOn(CpuDevice device, List<int> rgba)
