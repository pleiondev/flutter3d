{
  "f3dfx": 1,
  "author": "flutter3d fixtures",
  "effects": [
    {
      "name": "core",
      "description": "The bright core of a blast: fast, brief, slowed at once.",
      "count": 90,
      "lifetime": [0.25, 0.6],
      "size": [0.35, 0.9],
      "color": [3.2, 1.5, 0.45, 1.0],
      "emitter": {"shape": "sphere", "speed": [4.0, 16.0], "radius": [0.0, 0.4]},
      "affectors": [
        {"type": "drag", "perSecond": 6.0},
        {"type": "gravity", "acceleration": -3.0},
        {"type": "colorOverLife", "from": [3.2, 1.5, 0.45, 1.0], "to": [0.6, 0.15, 0.05, 1.0]},
        {"type": "sizeOverLife", "from": 0.7, "to": 1.6},
        {"type": "fade", "startsAt": 0.35}
      ],
      "render": {"drawing": "billboard", "blend": "additive", "texture": "spark.png", "flipbook": {"columns": 4, "rows": 4, "frames": 14}, "softness": 0.3},
      "on": [{"event": "elements.exploded"}],
      "editor": {"colour": "orange"}
    },
    {
      "name": "debris",
      "count": 12,
      "lifetime": 1.2,
      "size": [0.04, 0.09],
      "color": [0.4, 0.35, 0.3],
      "emitter": {"shape": "cone", "speed": [3.0, 7.0], "halfAngleDegrees": 40.0},
      "affectors": [
        {"type": "gravity"},
        {"type": "collide", "against": "plane", "height": 0.0, "bounce": 0.35, "friction": 0.4},
        {"type": "collide", "against": "depth"},
        {"type": "spin", "turnsPerSecond": 1.5, "randomizeStart": false}
      ],
      "render": {"drawing": "mesh", "blend": "darkening", "mesh": "chip"},
      "on": [{"event": "elements.exploded", "direction": [0.0, 1.0, 0.0]}]
    },
    {
      "name": "smoke",
      "rate": 34.0,
      "lifetime": [0.9, 1.8],
      "size": [0.22, 0.4],
      "color": [0.2, 0.17, 0.15, 1.0],
      "emitter": {"shape": "box", "halfExtents": [0.35, 0.1, 0.35], "speed": [0.5, 1.3], "along": [0.0, 1.0, 0.0]},
      "affectors": [
        {"type": "drag", "perSecond": 1.4},
        {"type": "turbulence", "strength": 0.9, "scale": 1.2},
        {"type": "wind", "acceleration": [0.3, 0.0, 0.0]},
        {"type": "sizeCurve", "keys": [
          {"at": 0.0, "value": 0.5, "ease": "smooth"},
          {"at": 0.45, "value": 1.7, "ease": "smooth"},
          {"at": 1.0, "value": 2.1}
        ]},
        {"type": "fade", "startsAt": 0.25}
      ],
      "render": {"drawing": "sixWay", "sheet": {"positive": "smoke_rtb.png", "negative": "smoke_lbf.png"}, "flipbook": {"columns": 8, "rows": 8, "loops": 1}, "softness": 0.5},
      "on": [{"event": "elements.exploded", "emit": "timed", "seconds": 0.85}]
    },
    {
      "name": "glow",
      "rate": 20.0,
      "lifetime": [0.4, 0.8],
      "size": 0.2,
      "color": [1.0, 0.6, 0.2, 1.0],
      "emitter": {"shape": "drift", "speed": [0.3, 0.8], "spread": [-0.2, 0.2]},
      "affectors": [
        {"type": "colorGradient", "keys": [
          {"at": 0.0, "color": [1.0, 0.86, 0.55, 1.0], "ease": "smooth"},
          {"at": 0.35, "color": [1.0, 0.66, 0.24, 1.0], "ease": "step"},
          {"at": 1.0, "color": [0.55, 0.08, 0.02, 1.0]}
        ]}
      ],
      "on": [{"event": "beacon.lit", "emit": "timed", "perSecond": 60.0, "seconds": 1.5, "at": [0.0, 2.0, 0.0]}]
    }
  ]
}
