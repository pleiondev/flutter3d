# The server protocol of flutter3d_hub: what a client sends and
# what a server answers, exchange by exchange.
# Generated by `dart run api_snapshot:schema_snapshot --update flutter3d_hub` in tool/api. Do not edit.
# A change here is a decision on the protocol version: within a major it only grows.

server flutter3d.hub
  schema 1.0.0

tool hello
  says The server says which protocol it speaks and where its mirrors are.
  hints readOnly idempotent
  arg protocol required {"pattern":"^[1-9][0-9]*\\.(0|[1-9][0-9]*)$","type":"string"}
  out {"properties":{"mirrors":{"items":{"format":"uri","type":"string"},"type":"array"},"protocol":{"pattern":"^[1-9][0-9]*\\.(0|[1-9][0-9]*)$","type":"string"},"server":{"type":"string"}},"required":["protocol","server"],"type":"object"}

tool resolve
  says What one version of one model is: its hash, its size, its format, where its bytes are, and its licence and author.
  hints readOnly idempotent
  arg protocol required {"pattern":"^[1-9][0-9]*\\.(0|[1-9][0-9]*)$","type":"string"}
  arg reference required {"pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}@[1-9][0-9]*(#sha256=[0-9a-f]{64})?$","type":"string"}
  out {"properties":{"author":{"type":"string"},"bytes":{"minimum":0,"type":"integer"},"format":{"type":"string"},"license":{"type":"string"},"name":{"type":"string"},"protocol":{"pattern":"^[1-9][0-9]*\\.(0|[1-9][0-9]*)$","type":"string"},"sha256":{"pattern":"^[0-9a-f]{64}$","type":"string"},"url":{"format":"uri","type":"string"},"uuid":{"pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$","type":"string"},"version":{"maximum":2147483647,"minimum":1,"type":"integer"}},"required":["bytes","format","license","protocol","sha256","url","uuid","version"],"type":"object"}

tool refusal
  says The answer to any request the server refuses, in place of the answer it asked for.
  hints readOnly idempotent
  out {"properties":{"message":{"type":"string"},"protocol":{"pattern":"^[1-9][0-9]*\\.(0|[1-9][0-9]*)$","type":"string"},"reason":{"type":"string"}},"required":["message","protocol","reason"],"type":"object"}
