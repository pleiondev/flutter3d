# The MCP tools of flutter3d_build: what each server offers an agent.
# Generated by `dart run api_snapshot:schema_snapshot --update flutter3d_build` in tool/api. Do not edit.
# A change here is a semver decision: see "Tools for agents are a contract too" in CONTRIBUTING.md.

server flutter3d.plugins
  schema 1.0.0

tool flutter3d.schema
  says The schema versions this server speaks: its own, and each plugin namespace's that declared one.
  hints readOnly idempotent
  out {"properties":{"namespaces":{"additionalProperties":{"type":"string"},"type":"object"},"schemaVersion":{"type":"string"},"server":{"type":"string"}},"required":["namespaces","server"],"type":"object"}

tool plugin.conformance
  says Run the plugin's conformance suite (test/conformance_test.dart) and say, test by test, what passed, failed or was declined.
  hints readOnly
  arg directory required {"type":"string"}

tool plugin.create
  says Write a new flutter3d plugin package from a template: a pubspec with the discovery marker, the plugin, a test that installs it and the conformance suite.
  hints writes
  arg directory required {"type":"string"}
  arg kind required {"enum":["render-step","effect","genre","element","tool"],"type":"string"}
  arg name required {"type":"string"}

tool plugin.report
  says Say what the plugin package is — its name and discovery marker — how each check went in its last conformance run, and whether it earns the conformance badge.
  hints readOnly
  arg directory required {"type":"string"}
