tool view.render
  says A picture of the project as it stands, from one of seven views — front, back, left, right, top, bottom, or the three-quarter iso view (the default).
  hints readOnly
  arg joint {"type":"integer"}
  arg mode {"enum":["material","normals","selection","weights","wireframe"],"type":"string"}
  arg size {"type":"integer"}
  arg view {"enum":["front","back","left","right","top","bottom","iso"],"type":"string"}
  out {"properties":{"did":{"type":"boolean"},"ids":{"items":{"type":"integer"},"type":"array"},"says":{"type":"string"},"selection":{"properties":{"elements":{"items":{"type":"integer"},"type":"array"},"level":{"type":"string"},"mode":{"type":"string"},"object":{"type":"integer"},"objects":{"items":{"type":"integer"},"type":"array"}},"required":["mode","objects"],"type":"object"}},"required":["did","ids","says","selection"],"type":"object"}

tool view.renderSheet
  says A 2×2 contact sheet: front, right, top and iso, one picture, each quadrant labelled with the view it is — the whole silhouette an agent more often needs than any single view.
  hints readOnly
  arg joint {"type":"integer"}
  arg mode {"enum":["material","normals","selection","weights","wireframe"],"type":"string"}
  out {"properties":{"did":{"type":"boolean"},"ids":{"items":{"type":"integer"},"type":"array"},"says":{"type":"string"},"selection":{"properties":{"elements":{"items":{"type":"integer"},"type":"array"},"level":{"type":"string"},"mode":{"type":"string"},"object":{"type":"integer"},"objects":{"items":{"type":"integer"},"type":"array"}},"required":["mode","objects"],"type":"object"}},"required":["did","ids","says","selection"],"type":"object"}

