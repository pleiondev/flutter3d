tool project.export
  says Take the project out to a format a game or another tool reads: "f3d" (the engine container), "glb" (a glTF binary most other tools open), "obj" (triangles that every tool reads), "stl" (a triangle soup a slicer reads), "stlAscii" (triangles as text, one facet at a time), "usdz" (geometry for Quick Look, no materials yet).
  hints destructive
  arg force {"type":"boolean"}
  arg format {"type":"string"}
  arg to required {"type":"string"}
  out {"properties":{"did":{"type":"boolean"},"ids":{"items":{"type":"integer"},"type":"array"},"says":{"type":"string"},"selection":{"properties":{"elements":{"items":{"type":"integer"},"type":"array"},"level":{"type":"string"},"mode":{"type":"string"},"object":{"type":"integer"},"objects":{"items":{"type":"integer"},"type":"array"}},"required":["mode","objects"],"type":"object"}},"required":["did","ids","says","selection"],"type":"object"}

tool project.import
  says Bring a glTF, GLB, OBJ, `.f3d` or STL file in as new objects, added beside what is already here.
