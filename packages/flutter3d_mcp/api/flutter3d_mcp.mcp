# The MCP tools of flutter3d_mcp: what each server offers an agent.
# Generated by `dart run api_snapshot:schema_snapshot --update flutter3d_mcp` in tool/api. Do not edit.
# A change here is a semver decision: see "Tools for agents are a contract too" in CONTRIBUTING.md.

server flutter3d.editor
  schema 1.0.0
  alias addBrush -> brush.add
  alias addLight -> light.add
  alias applyOverrides -> prefab.applyOverrides
  alias brighten -> light.brighten
  alias capture_draw -> capture.draw
  alias capture_open -> capture.open
  alias createPrefab -> prefab.create
  alias delete -> selection.delete
  alias duplicate -> selection.duplicate
  alias generate -> kit.place
  alias generate_level -> level.generate
  alias list -> level.list
  alias moveBy -> selection.move
  alias optimizeLights -> light.optimize
  alias place -> level.place
  alias placePrefab -> prefab.place
  alias play -> play.start
  alias play_build -> play.build
  alias play_devices -> play.devices
  alias play_events -> play.events
  alias play_keep_tape -> play.keepTape
  alias play_send_level -> play.sendLevel
  alias play_status -> play.status
  alias play_stop -> play.stop
  alias play_swap -> play.swap
  alias prefabs -> prefab.list
  alias redo -> history.redo
  alias removeBehaviour -> behavior.remove
  alias removeCutscene -> cutscene.remove
  alias render_capture_save -> render.saveCapture
  alias render_debug_views -> render.debugViews
  alias render_draw -> render.draw
  alias render_draws -> render.draws
  alias render_memory -> render.memory
  alias render_pass_output -> render.passOutput
  alias render_passes -> render.passes
  alias render_pick -> render.pick
  alias render_read_pixel -> render.readPixel
  alias render_scan_nan -> render.scanNan
  alias render_stats -> render.stats
  alias report -> view.report
  alias resize -> selection.resize
  alias revertOverrides -> prefab.revertOverrides
  alias save -> level.save
  alias screenshot -> view.screenshot
  alias select -> selection.set
  alias setBehaviour -> behavior.set
  alias setCutscene -> cutscene.set
  alias setField -> selection.setField
  alias setLights -> light.replaceAll
  alias setOverride -> prefab.setOverride
  alias setPrefabField -> prefab.setField
  alias turn -> selection.turn
  alias undo -> history.undo
  alias unpackPrefab -> prefab.unpack
  alias validate -> level.validate

tool behavior.remove
  says Take a behaviour tree out of the level.
  hints writes
  arg name required {"type":"string"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool behavior.set
  says Write a behaviour tree into the level under a name; an entity runs it by naming it in its behaviour property (selection.setField).
  hints writes
  arg name required {"type":"string"}
  arg tree required {"properties":{},"type":"object"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool brush.add
  says Put a new box of geometry down and select it.
  hints writes
  arg at required {"items":{"type":"number"},"maxItems":3,"minItems":3,"type":"array"}
  arg material {"type":"string"}
  arg size {"items":{"type":"number"},"maxItems":3,"minItems":3,"type":"array"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool capture.draw
  says One draw of the capture capture.open holds: its pass, mesh, material, pipeline state and every uniform, decoded by shape.
  hints readOnly
  arg index required {"minimum":0,"type":"integer"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool capture.open
  says Open a frame capture file (render.saveCapture writes one; a bug report carries one): its passes, what each drew and what each image kept, with a picture of the last pass that has one — or of the pass given.
  hints readOnly
  arg pass {"type":"string"}
  arg path required {"type":"string"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool command.run
  says Run any command the editor knows by its name, with its own arguments: the built-in ones (moveBy, addBrush, …) and every one the project's plugins added, named `<plugin id>.<name>`.
  hints writes
  arg arguments {"properties":{},"type":"object"}
  arg name required {"type":"string"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool cutscene.remove
  says Take a cutscene out of the level.
  hints writes
  arg name required {"type":"string"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool cutscene.set
  says Write a cutscene into the level under a name: a cutscene entity holding the sequence, which a trigger, button or relay whose target is the name starts.
  hints writes
  arg at {"items":{"type":"number"},"maxItems":3,"minItems":3,"type":"array"}
  arg name required {"type":"string"}
  arg sequence required {"properties":{},"type":"object"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool flutter3d.schema
  says The schema versions this server speaks: its own, and each plugin namespace's that declared one.
  hints readOnly idempotent
  out {"properties":{"namespaces":{"additionalProperties":{"type":"string"},"type":"object"},"schemaVersion":{"type":"string"},"server":{"type":"string"}},"required":["namespaces","server"],"type":"object"}

tool history.redo
  says Put back the change undo took away.
  hints writes
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool history.undo
  says Put the document back the way it was before the last change, and say which change that was.
  hints writes
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool kit.place
  says Add a piece of level built by a seeded kit: a room with doorways cut in its walls, a corridor, or a scatter of copies of one thing.
  hints writes
  arg kind required {"enum":["room","corridor","scatter"],"type":"string"}
  arg params {"properties":{},"type":"object"}
  arg seed {"type":"integer"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool level.generate
  says Replace the open level with a whole one made from a seed: rooms laid out by wave function collapse on a grid of cells, corridors where two rooms face each other through a doorway, a light in each room, the player in one and the exit in the room farthest from it — refused unless a body can walk from the start to the exit.
  hints destructive
  arg rules {"properties":{},"type":"object"}
  arg seed required {"type":"integer"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool level.list
  says Everything in the level, one line each: the kind, the index, what the document calls it, where it is and how big it is.
  hints readOnly
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool level.place
  says Put one of something the level already contains at a point, and select it.
  hints writes
  arg at required {"items":{"type":"number"},"maxItems":3,"minItems":3,"type":"array"}
  arg kind required {"enum":["brush","light","entity"],"type":"string"}
  arg what required {"type":"string"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool level.save
  says Write the document out.
  hints destructive
  arg path {"type":"string"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool level.validate
  says What is wrong with the level, as the game would see it: geometry that overlaps, a brush naming a material nothing declares, a light that reaches nowhere, two things answering to one name.
  hints readOnly
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool light.add
  says Put a new point light down and select it.
  hints writes
  arg at required {"items":{"type":"number"},"maxItems":3,"minItems":3,"type":"array"}
  arg intensity {"type":"number"}
  arg range {"type":"number"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool light.brighten
  says Multiply the selected light's strength by a factor.
  hints writes
  arg by required {"exclusiveMinimum":0,"type":"number"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool light.optimize
  says Fewer lights that light the level the way it is lit now.
  hints writes
  arg apply {"type":"boolean"}
  arg views {"items":{"properties":{"at":{"items":{"type":"number"},"maxItems":3,"minItems":3,"type":"array"},"from":{"items":{"type":"number"},"maxItems":3,"minItems":3,"type":"array"}},"required":["at","from"],"type":"object"},"type":"array"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool light.replaceAll
  says Replace every light in the level with the ones given, as one change that one undo takes back.
  hints writes
  arg lights required {"items":{"properties":{},"type":"object"},"type":"array"}
  arg why {"type":"string"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool play.build
  says Build the game this level belongs to with flutter build, without running it: whether its code compiles for a target, and the error lines when it does not.
  hints readOnly openWorld
  arg release {"type":"boolean"}
  arg target {"enum":["macos","linux","windows","web","apk","appbundle","ios"],"type":"string"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool play.devices
  says The devices play can run the game on — this computer, a browser, a phone on the cable — one per line with the id play takes.
  hints readOnly openWorld
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool play.events
  says What the game started by play has posted about itself — a level loaded, the player died or came back, a pickup taken, the way out reached — in order, each with its sequence number, kind, time and data.
  hints readOnly
  arg kinds {"items":{"type":"string"},"type":"array"}
  arg since {"minimum":0,"type":"integer"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool play.keepTape
  says Keep the last seconds the running game recorded as a .f3drun in its project's test/tapes/, under a name: the run that just went wrong, where replay tests and the sim server's verify and bisect read tapes from.
  hints destructive
  arg name required {"type":"string"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool play.sendLevel
  says Send the level as it stands now, unsaved changes included, to the game started by play, which takes it without starting over; the file on disk is not written.
  hints writes
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool play.start
  says Run the game this level belongs to (the Flutter project above the level file) with flutter run, and wait until it is up or has failed; answers with where it runs and the last lines it printed.
  hints openWorld
  arg device {"type":"string"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool play.status
  says Where the game started by play is — starting, running, stopped — and the last lines of its console: what the game printed, build errors, what the last play.swap said.
  hints readOnly
  arg lines {"minimum":0,"type":"integer"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool play.stop
  says Stop the game started by play, and the flutter run with it.
  hints destructive
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool play.swap
  says Swap the running game's code after it changed, the way flutter run does on r: the game keeps its state and picks up the new code, shaders and models.
  hints writes
  arg restart {"type":"boolean"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool prefab.applyOverrides
  says Write the selected instance's overrides into its prefab, so every instance gets them, and drop them from this one.
  hints writes
  arg path {"type":"string"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool prefab.create
  says Turn the selected entities into a prefab — a template placed as one thing — and put one instance of it where they were.
  hints writes
  arg prefab required {"type":"string"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool prefab.list
  says The level's prefabs: each id, how many instances it has, and every entity of its template with the path prefab.setOverride and setPrefabField address it by, nested prefabs included.
  hints readOnly
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool prefab.place
  says Put an instance of one of the level's prefabs down and select it.
  hints writes
  arg at required {"items":{"type":"number"},"maxItems":3,"minItems":3,"type":"array"}
  arg name {"type":"string"}
  arg prefab required {"type":"string"}
  arg yaw {"type":"number"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool prefab.revertOverrides
  says Drop the selected instance's overrides, so it shows its prefab again: all of them, those of one path, or one key there.
  hints writes
  arg key {"type":"string"}
  arg path {"type":"string"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool prefab.setField
  says Change one key of one entity in a prefab's template — the edit every instance sees, except those that override that key.
  hints writes
  arg key required {"type":"string"}
  arg path required {"type":"string"}
  arg prefab required {"type":"string"}
  arg value {"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"array"},{"properties":{},"type":"object"},{"type":"null"}]}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool prefab.setOverride
  says Change one key of one entity in the selected prefab instance only.
  hints writes
  arg key required {"type":"string"}
  arg path required {"type":"string"}
  arg value {"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"array"},{"properties":{},"type":"object"},{"type":"null"}]}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool prefab.unpack
  says Break the selected instance's link: the entities it stands for become the level's own and later edits of the prefab no longer reach them.
  hints writes
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool render.debugViews
  says Every debug view by name, with its kind (material, geometry, identity, validation) and what it paints: the names RenderSettings.debugView and SceneNode.debugView take.
  hints readOnly
  arg vmService {"type":"string"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool render.draw
  says One draw of the captured frame: its pipeline state and every value bound for it.
  hints readOnly
  arg index required {"type":"integer"}
  arg vmService {"type":"string"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool render.draws
  says The draws of the captured frame, a page at a time: index, pass, node name, material, sizes.
  hints readOnly
  arg fresh {"type":"boolean"}
  arg limit {"type":"integer"}
  arg offset {"type":"integer"}
  arg pass {"type":"string"}
  arg vmService {"type":"string"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool render.memory
  says What the running game's renderer holds on the device, by category — textures, buffers, render targets, meshes, shaders and pipelines — each line with its count and bytes, largest first.
  hints readOnly
  arg vmService {"type":"string"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool render.passOutput
  says A summary of one pass's output: its format, size and range.
  hints readOnly
  arg pass required {"type":"string"}
  arg resource {"type":"string"}
  arg vmService {"type":"string"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool render.passes
  says The running game's next frame, pass by pass: each pass, what it read and wrote, how many draws it made, and the frame's size.
  hints readOnly
  arg fresh {"type":"boolean"}
  arg vmService {"type":"string"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool render.pick
  says Which draws put the pixel at x, y (from the top left) on the screen: the node the picking pass found there and its draws, in a capture of that same frame, which the other render tools then read.
  hints readOnly
  arg vmService {"type":"string"}
  arg x required {"type":"integer"}
  arg y required {"type":"integer"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool render.readPixel
  says One pixel of one pass's output, as stored and as read back.
  hints readOnly
  arg pass required {"type":"string"}
  arg resource {"type":"string"}
  arg vmService {"type":"string"}
  arg x required {"type":"integer"}
  arg y required {"type":"integer"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool render.saveCapture
  says The running game's captured frame written to a file: every pass, every draw with its uniforms decoded, and a PNG thumbnail of every image.
  hints destructive
  arg floats {"type":"boolean"}
  arg fresh {"type":"boolean"}
  arg images {"type":"boolean"}
  arg notes {"type":"string"}
  arg path required {"type":"string"}
  arg thumbnail {"minimum":1,"type":"integer"}
  arg vmService {"type":"string"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool render.scanNan
  says Every pass output searched for NaN and infinity, with the first pixel of each.
  hints readOnly
  arg fresh {"type":"boolean"}
  arg vmService {"type":"string"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool render.stats
  says What the next frame cost: draws, triangles, passes, targets.
  hints readOnly
  arg fresh {"type":"boolean"}
  arg vmService {"type":"string"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool selection.delete
  says Remove the selection.
  hints writes
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool selection.duplicate
  says Copy the selection a step to the side and select the copy.
  hints writes
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool selection.move
  says Move the selection by a vector, in metres.
  hints writes
  arg by required {"items":{"type":"number"},"maxItems":3,"minItems":3,"type":"array"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool selection.resize
  says Grow or shrink the selected brush about its own centre, in metres.
  hints writes
  arg by required {"items":{"type":"number"},"maxItems":3,"minItems":3,"type":"array"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool selection.set
  says Choose what the other tools act on, by the kind and index list printed.
  hints writes
  arg also {"type":"boolean"}
  arg index {"minimum":0,"type":"integer"}
  arg kind {"enum":["brush","light","entity"],"type":"string"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool selection.setField
  says Write one field of the selection, or clear it by leaving the value out.
  hints writes
  arg key required {"type":"string"}
  arg value {"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"array"},{"properties":{},"type":"object"},{"type":"null"}]}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool selection.turn
  says Turn the selected entity about the vertical, in radians.
  hints writes
  arg by required {"type":"number"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool view.report
  says What the camera sees, one line per brush, light and entity in the order list prints them: how many pixels of a 320×200 frame it owns (or whether it is hidden, outside the view or behind the camera), the box on the screen those pixels fill, how far away it is, and what covers the part of the screen it would fill — the things that can be in front of it, each with its share of that part.
  hints readOnly
  arg at {"items":{"type":"number"},"maxItems":3,"minItems":3,"type":"array"}
  arg from {"items":{"type":"number"},"maxItems":3,"minItems":3,"type":"array"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

tool view.screenshot
  says A picture of the level as it stands, drawn in software: every brush in its material's colour (no textures), lit by the level's own lights, with a small yellow box at each light and a blue one at each entity so things that have no shape can still be seen.
  hints readOnly
  arg at {"items":{"type":"number"},"maxItems":3,"minItems":3,"type":"array"}
  arg debugView {"type":"string"}
  arg from {"items":{"type":"number"},"maxItems":3,"minItems":3,"type":"array"}
  out {"properties":{"did":{"type":"boolean"},"hasPicture":{"type":"boolean"},"says":{"type":"string"},"selection":{"type":"string"}},"required":["did","hasPicture","says","selection"],"type":"object"}

server flutter3d.model
  schema 1.0.0
  alias addClip -> clip.add
  alias addImage -> image.add
  alias addJoint -> joint.add
  alias addLathe -> object.addLathe
  alias addLight -> light.add
  alias addLod -> lod.add
