tool animationGraph.remove
  says Remove the animation graph of that name; refused, naming the graphs there are, when there is none.
  hints writes
  arg edges {"items":{"type":"integer"},"type":"array"}
  arg faces {"items":{"type":"integer"},"type":"array"}
  arg graphName required {"type":"string"}
  arg ids {"items":{"type":"integer"},"type":"array"}
  arg object {"type":"integer"}
  arg vertices {"items":{"type":"integer"},"type":"array"}
  out {"properties":{"did":{"type":"boolean"},"ids":{"items":{"type":"integer"},"type":"array"},"says":{"type":"string"},"selection":{"properties":{"elements":{"items":{"type":"integer"},"type":"array"},"level":{"type":"string"},"mode":{"type":"string"},"object":{"type":"integer"},"objects":{"items":{"type":"integer"},"type":"array"}},"required":["mode","objects"],"type":"object"}},"required":["did","ids","says","selection"],"type":"object"}

tool animationGraph.set
  says Set the animation graph a game runs for a character, by name, replacing one of that name; it is exported into the model's root extras, where AnimationGraphJson.graphsIn reads it.
  hints writes
  arg edges {"items":{"type":"integer"},"type":"array"}
  arg faces {"items":{"type":"integer"},"type":"array"}
  arg graph required {"properties":{"parameters":{"items":{"properties":{},"type":"object"},"type":"array"},"states":{"items":{"properties":{},"type":"object"},"type":"array"},"transitions":{"items":{"properties":{},"type":"object"},"type":"array"}},"required":["parameters","states"],"type":"object"}
  arg graphName required {"type":"string"}
  arg ids {"items":{"type":"integer"},"type":"array"}
  arg object {"type":"integer"}
  arg vertices {"items":{"type":"integer"},"type":"array"}
  out {"properties":{"did":{"type":"boolean"},"ids":{"items":{"type":"integer"},"type":"array"},"says":{"type":"string"},"selection":{"properties":{"elements":{"items":{"type":"integer"},"type":"array"},"level":{"type":"string"},"mode":{"type":"string"},"object":{"type":"integer"},"objects":{"items":{"type":"integer"},"type":"array"}},"required":["mode","objects"],"type":"object"}},"required":["did","ids","says","selection"],"type":"object"}

tool asset.audit
  says Check an asset that came from somewhere else before it goes into a game: its overall size (outside 1 cm…100 m is a unit mistake), its origin against the middle of its base, duplicate materials, what rebuilding each imported mesh would have to drop or split, and every `check` issue including the triangle and texture budgets — with a 4×2 sheet of all seven views.
  hints writes
  arg profile {"enum":["desktop","mobile","web"],"type":"string"}
  arg repair {"type":"boolean"}
  out {"properties":{"did":{"type":"boolean"},"ids":{"items":{"type":"integer"},"type":"array"},"says":{"type":"string"},"selection":{"properties":{"elements":{"items":{"type":"integer"},"type":"array"},"level":{"type":"string"},"mode":{"type":"string"},"object":{"type":"integer"},"objects":{"items":{"type":"integer"},"type":"array"}},"required":["mode","objects"],"type":"object"}},"required":["did","ids","says","selection"],"type":"object"}

tool clip.add
  says Add a new, empty animation clip — no tracks yet — appended at the end of the clip list.
  hints writes
  arg clipName {"type":"string"}
  arg edges {"items":{"type":"integer"},"type":"array"}
  arg faces {"items":{"type":"integer"},"type":"array"}
  arg ids {"items":{"type":"integer"},"type":"array"}
  arg object {"type":"integer"}
  arg vertices {"items":{"type":"integer"},"type":"array"}
  out {"properties":{"did":{"type":"boolean"},"ids":{"items":{"type":"integer"},"type":"array"},"says":{"type":"string"},"selection":{"properties":{"elements":{"items":{"type":"integer"},"type":"array"},"level":{"type":"string"},"mode":{"type":"string"},"object":{"type":"integer"},"objects":{"items":{"type":"integer"},"type":"array"}},"required":["mode","objects"],"type":"object"}},"required":["did","ids","says","selection"],"type":"object"}

tool clip.applyResult
  says Write a baked clip — retargetClip/bakeIk/bakeDrivers's own result, or one computed some other way — into the project.
  hints writes
  arg clip required {"properties":{"extras":{"properties":{},"type":"object"},"name":{"type":"string"},"tracks":{"items":{"properties":{"objectId":{"type":"integer"},"track":{"properties":{"componentCount":{"type":"integer"},"interpolation":{"enum":["step","linear","cubicSpline"],"type":"string"},"nodeIndex":{"type":"integer"},"path":{"enum":["translation","rotation","scale","weights","pointer"],"type":"string"},"times":{"items":{"type":"number"},"type":"array"},"values":{"items":{"type":"number"},"type":"array"}},"required":["componentCount","interpolation","nodeIndex","path","times","values"],"type":"object"}},"required":["objectId","track"],"type":"object"},"type":"array"}},"required":["tracks"],"type":"object"}
  arg clipIndex {"type":"integer"}
  arg edges {"items":{"type":"integer"},"type":"array"}
  arg faces {"items":{"type":"integer"},"type":"array"}
  arg ids {"items":{"type":"integer"},"type":"array"}
  arg object {"type":"integer"}
  arg vertices {"items":{"type":"integer"},"type":"array"}
  out {"properties":{"did":{"type":"boolean"},"ids":{"items":{"type":"integer"},"type":"array"},"says":{"type":"string"},"selection":{"properties":{"elements":{"items":{"type":"integer"},"type":"array"},"level":{"type":"string"},"mode":{"type":"string"},"object":{"type":"integer"},"objects":{"items":{"type":"integer"},"type":"array"}},"required":["mode","objects"],"type":"object"}},"required":["did","ids","says","selection"],"type":"object"}

tool clip.bakeDrivers
  says Bake one or more shape-key drivers (each reading how far a joint has turned about one axis) into one more weights track on a clip, naming the shape-owning object — additive, so drivers naming the same shape add rather than the second overwriting the first.
  hints writes
  arg clipIndex required {"type":"integer"}
  arg drivers {"items":{"properties":{"axis":{"enum":["x","y","z"],"type":"string"},"from":{"type":"number"},"jointId":{"type":"integer"},"shapeIndex":{"type":"integer"},"to":{"type":"number"}},"required":["from","jointId","shapeIndex","to"],"type":"object"},"type":"array"}
  arg shapeTargetObjectId required {"type":"integer"}
  out {"properties":{"did":{"type":"boolean"},"ids":{"items":{"type":"integer"},"type":"array"},"says":{"type":"string"},"selection":{"properties":{"elements":{"items":{"type":"integer"},"type":"array"},"level":{"type":"string"},"mode":{"type":"string"},"object":{"type":"integer"},"objects":{"items":{"type":"integer"},"type":"array"}},"required":["mode","objects"],"type":"object"}},"required":["did","ids","says","selection"],"type":"object"}

tool clip.bakeIk
  says Solve a two-bone IK chain (root, mid, effector reaching for target, bending toward pole) at every 1/fps second of a clip, and write the result as the root and mid joints' own baked rotation keyframes — export always plays the baked clip, never a live IK constraint.
  hints writes
  arg clipIndex required {"type":"integer"}
  arg effectorJointId required {"type":"integer"}
  arg fps {"type":"number"}
  arg midJointId required {"type":"integer"}
  arg pole required {"items":{"type":"number"},"maxItems":3,"minItems":3,"type":"array"}
  arg rootJointId required {"type":"integer"}
  arg target required {"items":{"type":"number"},"maxItems":3,"minItems":3,"type":"array"}
  out {"properties":{"did":{"type":"boolean"},"ids":{"items":{"type":"integer"},"type":"array"},"says":{"type":"string"},"selection":{"properties":{"elements":{"items":{"type":"integer"},"type":"array"},"level":{"type":"string"},"mode":{"type":"string"},"object":{"type":"integer"},"objects":{"items":{"type":"integer"},"type":"array"}},"required":["mode","objects"],"type":"object"}},"required":["did","ids","says","selection"],"type":"object"}

tool clip.bakeRootMotion
  says Restore a clip's own translation track for a root object from whatever extractRootMotion last saved — the exact inverse, key for key.
  hints writes
  arg clipIndex required {"type":"integer"}
  arg edges {"items":{"type":"integer"},"type":"array"}
  arg faces {"items":{"type":"integer"},"type":"array"}
  arg ids {"items":{"type":"integer"},"type":"array"}
  arg object {"type":"integer"}
  arg rootJoint required {"type":"integer"}
  arg vertices {"items":{"type":"integer"},"type":"array"}
  out {"properties":{"did":{"type":"boolean"},"ids":{"items":{"type":"integer"},"type":"array"},"says":{"type":"string"},"selection":{"properties":{"elements":{"items":{"type":"integer"},"type":"array"},"level":{"type":"string"},"mode":{"type":"string"},"object":{"type":"integer"},"objects":{"items":{"type":"integer"},"type":"array"}},"required":["mode","objects"],"type":"object"}},"required":["did","ids","says","selection"],"type":"object"}

tool clip.extractRootMotion
  says Flatten a clip's own translation track for a root object to its first key's value — the root stands still — after saving every key's real value on the clip itself, so bakeRootMotionIntoClip can restore them exactly.
  hints writes
  arg clipIndex required {"type":"integer"}
  arg edges {"items":{"type":"integer"},"type":"array"}
  arg faces {"items":{"type":"integer"},"type":"array"}
  arg ids {"items":{"type":"integer"},"type":"array"}
  arg object {"type":"integer"}
  arg rootJoint required {"type":"integer"}
  arg vertices {"items":{"type":"integer"},"type":"array"}
  out {"properties":{"did":{"type":"boolean"},"ids":{"items":{"type":"integer"},"type":"array"},"says":{"type":"string"},"selection":{"properties":{"elements":{"items":{"type":"integer"},"type":"array"},"level":{"type":"string"},"mode":{"type":"string"},"object":{"type":"integer"},"objects":{"items":{"type":"integer"},"type":"array"}},"required":["mode","objects"],"type":"object"}},"required":["did","ids","says","selection"],"type":"object"}

tool clip.retarget
  says Retarget a clip authored for one skeleton onto another skeleton's own joints — rest-relative rotation, height-scaled translation, with a two-bone IK foot lock by default — and append the result as a new clip.
  hints writes
  arg boneMap {"additionalProperties":{"type":"string"},"properties":{},"type":"object"}
  arg clipName {"type":"string"}
  arg footTolerance {"type":"number"}
  arg groundY {"type":"number"}
  arg lockFeet {"type":"boolean"}
  arg sourceClipIndex required {"type":"integer"}
  arg sourceSkeletonIndex required {"type":"integer"}
  arg targetSkeletonIndex required {"type":"integer"}
  out {"properties":{"did":{"type":"boolean"},"ids":{"items":{"type":"integer"},"type":"array"},"says":{"type":"string"},"selection":{"properties":{"elements":{"items":{"type":"integer"},"type":"array"},"level":{"type":"string"},"mode":{"type":"string"},"object":{"type":"integer"},"objects":{"items":{"type":"integer"},"type":"array"}},"required":["mode","objects"],"type":"object"}},"required":["did","ids","says","selection"],"type":"object"}

tool flutter3d.schema
  says The schema versions this server speaks: its own, and each plugin namespace's that declared one.
  hints readOnly idempotent
  out {"properties":{"namespaces":{"additionalProperties":{"type":"string"},"type":"object"},"schemaVersion":{"type":"string"},"server":{"type":"string"}},"required":["namespaces","server"],"type":"object"}

tool history.amend
  says Adjust the last operation instead of pushing a second one on top of it — the operation card's own slider.
  hints writes
  arg name required {"type":"string"}
  out {"properties":{"did":{"type":"boolean"},"ids":{"items":{"type":"integer"},"type":"array"},"says":{"type":"string"},"selection":{"properties":{"elements":{"items":{"type":"integer"},"type":"array"},"level":{"type":"string"},"mode":{"type":"string"},"object":{"type":"integer"},"objects":{"items":{"type":"integer"},"type":"array"}},"required":["mode","objects"],"type":"object"}},"required":["did","ids","says","selection"],"type":"object"}

tool history.batch
  says Run several commands as one undo step, all or nothing.
  hints writes
  arg commands required {"items":{"properties":{},"type":"object"},"minItems":1,"type":"array"}
  out {"properties":{"did":{"type":"boolean"},"ids":{"items":{"type":"integer"},"type":"array"},"says":{"type":"string"},"selection":{"properties":{"elements":{"items":{"type":"integer"},"type":"array"},"level":{"type":"string"},"mode":{"type":"string"},"object":{"type":"integer"},"objects":{"items":{"type":"integer"},"type":"array"}},"required":["mode","objects"],"type":"object"}},"required":["did","ids","says","selection"],"type":"object"}

tool history.redo
  says Put back the change that undo just took away.
  hints writes
  out {"properties":{"did":{"type":"boolean"},"ids":{"items":{"type":"integer"},"type":"array"},"says":{"type":"string"},"selection":{"properties":{"elements":{"items":{"type":"integer"},"type":"array"},"level":{"type":"string"},"mode":{"type":"string"},"object":{"type":"integer"},"objects":{"items":{"type":"integer"},"type":"array"}},"required":["mode","objects"],"type":"object"}},"required":["did","ids","says","selection"],"type":"object"}

tool history.undo
  says Put the project back the way it was before the last change, and say which change that was.
  hints writes
  out {"properties":{"did":{"type":"boolean"},"ids":{"items":{"type":"integer"},"type":"array"},"says":{"type":"string"},"selection":{"properties":{"elements":{"items":{"type":"integer"},"type":"array"},"level":{"type":"string"},"mode":{"type":"string"},"object":{"type":"integer"},"objects":{"items":{"type":"integer"},"type":"array"}},"required":["mode","objects"],"type":"object"}},"required":["did","ids","says","selection"],"type":"object"}

