  arg ssaa {"type":"integer"}
  arg tiles {"type":"integer"}
  arg view {"enum":["front","back","left","right","top","bottom","iso"],"type":"string"}
  arg width {"type":"integer"}
  out {"properties":{"did":{"type":"boolean"},"ids":{"items":{"type":"integer"},"type":"array"},"says":{"type":"string"},"selection":{"properties":{"elements":{"items":{"type":"integer"},"type":"array"},"level":{"type":"string"},"mode":{"type":"string"},"object":{"type":"integer"},"objects":{"items":{"type":"integer"},"type":"array"}},"required":["mode","objects"],"type":"object"}},"required":["did","ids","says","selection"],"type":"object"}

