{
  "format": "f3d.plugin",
  "version": 4,
  "requires": [],
  "generator": "flutter3d",
  "manifest": {
    "id": "acme_sample.pulse",
    "apiVersion": "1.0",
    "touches": "view",
    "description": "A render step driven by a Wasm render module, with a light type, a vertex layout and a level-of-detail table of its own, as data."
  },
  "renderSteps": [
    {
      "name": "beat",
      "anchor": "f3d.after_bloom",
      "shaders": {"material": "pulse.f3dmat"}
    }
  ],
  "wasmRender": [
    {
      "module": "pulse.wasm",
      "step": "beat",
      "parameters": ["tint", "strength"],
      "limits": {"fuelPerFrame": 1000}
    }
  ],
  "lightTypes": [
    {"name": "glowtube", "base": "point", "params": [1.5, 0, 0, 0]}
  ],
  "vertexLayouts": [
    {"name": "ribbon", "attributes": ["position", "color", "texcoord"]}
  ],
  "lodTables": [
    {"name": "shrubs", "distances": [10, 30]}
  ]
}
